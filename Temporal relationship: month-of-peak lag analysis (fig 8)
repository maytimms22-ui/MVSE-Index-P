# ============================================================
#  Month-of-Peak Comparison: Dengue Cases vs. P-Index
#  Publication-quality figures
# ============================================================
install.packages("readxl")
library(tidyverse)
library(readxl)
library(patchwork)
library(stringdist)

# ── 0. File paths ───────────────────────────────────────────
dengue_path <- "dengue_case_2012-2021-all_inclusive.xlsx"
pindex_path <- "IndexP_monthlydata.xlsx"

# ── 1. Load dengue data ─────────────────────────────────────
dengue_raw <- read_excel(dengue_path)

has_year <- any(str_to_lower(names(dengue_raw)) == "year")

if (has_year) {
  dengue <- dengue_raw %>%
    rename_with(str_to_lower) %>%
    select(province, year, month, total) %>%
    mutate(across(c(year, month, total), as.numeric))
} else {
  n_provinces <- n_distinct(dengue_raw$PROVINCE)
  dengue <- dengue_raw %>%
    rename_with(str_to_lower) %>%
    select(province, month, total) %>%
    mutate(
      row_id = row_number(),
      year   = 2012 + ((row_id - 1) %/% (n_provinces * 12))
    ) %>%
    mutate(across(c(year, month, total), as.numeric)) %>%
    select(province, year, month, total)
}

# ── 2. Load P-index data ────────────────────────────────────
pindex_sheets <- excel_sheets(pindex_path)

pindex_long <- map_dfr(pindex_sheets, function(sh) {
  raw <- read_excel(pindex_path, sheet = sh, col_names = TRUE)
  yr  <- as.numeric(names(raw)[1])
  raw <- raw[-1, ] %>%
    select(-1) %>%
    rename(province = 1)
  names(raw)[2:13] <- as.character(1:12)
  raw %>%
    pivot_longer(-province, names_to = "month", values_to = "pindex") %>%
    mutate(year = yr, month = as.numeric(month), pindex = as.numeric(pindex)) %>%
    select(province, year, month, pindex)
})

# ── 3. Harmonise province names ─────────────────────────────
dengue_provs <- unique(dengue$province)
pindex_provs <- unique(pindex_long$province)
match_idx    <- amatch(pindex_provs, dengue_provs, method = "jw", maxDist = 0.3)
prov_lookup  <- tibble(pindex_prov = pindex_provs,
                       dengue_prov = dengue_provs[match_idx])

pindex_long <- pindex_long %>%
  left_join(prov_lookup, by = c("province" = "pindex_prov")) %>%
  mutate(province = coalesce(dengue_prov, province)) %>%
  select(-dengue_prov)

# ── 4. Peak months & lag ────────────────────────────────────
dengue_peak <- dengue %>%
  group_by(province, year) %>%
  slice_max(total, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(province, year, peak_dengue = month)

pindex_peak <- pindex_long %>%
  group_by(province, year) %>%
  slice_max(pindex, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(province, year, peak_pindex = month)

peaks <- inner_join(dengue_peak, pindex_peak, by = c("province", "year")) %>%
  mutate(lag = peak_dengue - peak_pindex)

# ── 5. Shared publication theme ─────────────────────────────
pub_theme <- theme_classic(base_size = 11, base_family = "sans") +
  theme(
    # Titles & labels
    plot.title       = element_text(face = "bold", size = 12, hjust = 0,
                                    margin = margin(b = 4)),
    plot.subtitle    = element_text(size = 9, color = "grey35", hjust = 0,
                                    margin = margin(b = 8)),
    axis.title       = element_text(size = 10, face = "bold"),
    axis.text        = element_text(size = 9, color = "black"),
    axis.line        = element_line(color = "black", linewidth = 0.4),
    axis.ticks       = element_line(color = "black", linewidth = 0.4),
    # Grid — only horizontal minor guides
    panel.grid.major.y = element_line(color = "grey90", linewidth = 0.3),
    panel.grid.major.x = element_blank(),
    panel.grid.minor   = element_blank(),
    # Legend
    legend.title     = element_text(size = 9, face = "bold"),
    legend.text      = element_text(size = 8),
    legend.key.size  = unit(0.45, "cm"),
    legend.background = element_rect(fill = NA),
    # Margins
    plot.margin      = margin(10, 14, 8, 10)
  )

# ── 6a. Histogram ───────────────────────────────────────────
lag_range  <- range(peaks$lag)
break_vals <- seq(lag_range[1] - 0.5, lag_range[2] + 0.5, by = 1)

med_lag  <- median(peaks$lag)
mean_lag <- round(mean(peaks$lag), 2)

p_hist <- ggplot(peaks, aes(x = lag)) +
  geom_histogram(
    breaks = break_vals,
    fill   = "#2B7BB9",
    color  = "white",
    linewidth = 0.3
  ) +
  geom_vline(xintercept = 0,   linetype = "dashed", color = "#C0392B",
             linewidth = 0.7) +
  geom_vline(xintercept = med_lag, linetype = "dotted", color = "grey30",
             linewidth = 0.6) +
  annotate("text", x = 0.15, y = Inf,
           label = "No lag", color = "#C0392B", size = 2.8,
           hjust = 0, vjust = 1.6, fontface = "italic") +
  annotate("text", x = med_lag + 0.15, y = Inf,
           label = paste0("Median = ", med_lag), color = "grey30",
           size = 2.8, hjust = 0, vjust = 3.2, fontface = "italic") +
  scale_x_continuous(
    breaks = seq(lag_range[1], lag_range[2], by = 1),
    expand = expansion(mult = c(0.02, 0.02))
  ) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.08))) +
  labs(
    title    = "(A)  Distribution of peak-month lag",
    subtitle = paste0("n = ", nrow(peaks), " province-year observations  |  ",
                      n_distinct(peaks$province), " provinces  |  ",
                      min(peaks$year), "\u2013", max(peaks$year),
                      "  |  mean lag = ", mean_lag, " months"),
    x = "Lag (months); positive values indicate dengue peak occurs after P-index peak",
    y = "Number of province-year observations"
  ) +
  pub_theme

# ── 6b. Proportion bar chart ────────────────────────────────
lag_counts <- peaks %>%
  count(lag) %>%
  mutate(pct = n / sum(n) * 100,
         fill_col = case_when(
           lag == 0  ~ "zero",
           lag  > 0  ~ "positive",
           TRUE      ~ "negative"
         ))

p_bar <- ggplot(lag_counts, aes(x = factor(lag), y = pct, fill = fill_col)) +
  geom_col(color = "white", linewidth = 0.3, width = 0.75) +
  geom_text(aes(label = ifelse(pct >= 2, sprintf("%.1f%%", pct), "")),
            vjust = -0.5, size = 2.8, fontface = "plain", color = "black") +
  scale_fill_manual(
    values = c("negative" = "#7FB3D3", "zero" = "#C0392B", "positive" = "#2B7BB9"),
    labels = c("negative" = "Dengue peaks before P-index",
               "zero"     = "Same month",
               "positive" = "Dengue peaks after P-index"),
    name   = NULL
  ) +
  scale_y_continuous(
    expand = expansion(mult = c(0, 0.1)),
    labels = function(x) paste0(x, "%")
  ) +
  labs(
    title = "(B)  Proportion of observations by lag value",
    x     = "Lag (months)",
    y     = "Percentage of observations (%)"
  ) +
  pub_theme +
  theme(
    legend.position  = "top",
    legend.direction = "horizontal",
    legend.margin    = margin(b = -4)
  )

# ── 6c. Heatmap ─────────────────────────────────────────────
province_order <- peaks %>%
  group_by(province) %>%
  summarise(med_lag = median(lag), .groups = "drop") %>%
  arrange(med_lag) %>%
  pull(province)

abs_max <- max(abs(lag_range))

p_heat <- peaks %>%
  mutate(province = factor(province, levels = province_order)) %>%
  ggplot(aes(x = factor(year), y = province, fill = lag)) +
  geom_tile(color = "white", linewidth = 0.25) +
  scale_fill_gradient2(
    low      = "#2166AC",
    mid      = "#F7F7F7",
    high     = "#B2182B",
    midpoint = 0,
    limits   = c(-abs_max, abs_max),
    name     = "Lag (months)",
    guide    = guide_colorbar(
      barwidth  = 8,
      barheight = 0.5,
      title.position = "top",
      title.hjust    = 0.5
    )
  ) +
  labs(
    title = "(C)  Lag by province and year",
    x     = "Year",
    y     = NULL
  ) +
  theme_classic(base_size = 10, base_family = "sans") +
  theme(
    plot.title       = element_text(face = "bold", size = 12, hjust = 0,
                                    margin = margin(b = 6)),
    axis.title.x     = element_text(size = 10, face = "bold"),
    axis.text.y      = element_text(size = 7.5, color = "black"),
    axis.text.x      = element_text(size = 9,   color = "black",
                                    angle = 45,  hjust = 1),
    axis.line        = element_blank(),
    axis.ticks       = element_blank(),
    legend.position  = "bottom",
    legend.title     = element_text(size = 9, face = "bold"),
    legend.text      = element_text(size = 8),
    plot.margin      = margin(10, 14, 8, 10)
  )

# ── 7. Assemble & export ────────────────────────────────────
combined <- (p_hist / p_bar / p_heat) +
  plot_layout(heights = c(1, 1, 1.8)) +
  plot_annotation(
    caption = paste0(
      "Lag = month of peak dengue total \u2212 month of peak P-index, ",
      "calculated per province per year (2012\u20132021).\n",
      "Red dashed line and red bars indicate a lag of zero (peaks occur in the same month). ",
      "Blue indicates dengue peaks after the P-index; grey indicates before."
    ),
    theme = theme(
      plot.caption = element_text(size = 8, color = "grey30",
                                  hjust = 0, lineheight = 1.3,
                                  margin = margin(t = 10))
    )
  )

print(combined)
print(p_hist)
print(p_heat)
print(p_bar)

# Save at 300 dpi (journal standard), 174 mm wide (double-column)
ggsave("peak_month_comparison.png",
       plot   = combined,
       width  = 174,   # mm — standard double-column width
       height = 240,   # mm
       units  = "mm",
       dpi    = 300,
       bg     = "white")

# Also save as vector PDF for submission
ggsave("peak_month_comparison.pdf",
       plot   = combined,
       width  = 174,
       height = 240,
       units  = "mm",
       bg     = "white")

cat("Saved: peak_month_comparison.png  (300 dpi)\n")
cat("Saved: peak_month_comparison.pdf  (vector, for journal submission)\n")

write_csv(peaks, "peak_month_summary.csv")
cat("Saved: peak_month_summary.csv\n")
