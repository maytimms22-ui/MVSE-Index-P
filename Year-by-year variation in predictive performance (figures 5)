p_index <- read_excel("~/desktop/publications/IndexP_monthly_all-inclusive.xlsx",
                      sheet = 1) %>%
  rename(INDEXP = 'INDEX-P') %>%
  mutate(
    PROVINCE = str_trim(PROVINCE),
    YEAR = as.integer(YEAR),
    MONTH = as.integer(MONTH)
  )

dat_monthly <- dengue_cases %>%
  inner_join(p_index, by = c("PROVINCE", "YEAR", "MONTH"))

dat_yearly <- dat_monthly %>%
  group_by(PROVINCE, YEAR) %>%
  summarise(
    DF_year = sum(DF, na.rm = TRUE),
    DS_year = sum(DS, na.rm = TRUE),
    TOTAL_year = sum(TOTAL, na.rm = TRUE),
    INDEXP_mean = mean(INDEXP, na.rm = TRUE),
    .groups = "drop"
  )

calc_cor <- function(data, dengue_var = "DF_year") {
  data %>%
    group_by(PROVINCE) %>%
    summarise(
      col_val = if (n() >= 3 && sd(.data[[dengue_var]]) > 0 && sd (INDEXP_mean) > 0)
        cor(.data[[dengue_var]], INDEXP_mean, use = "pairwise.complete.pbs")
      else NA_real_,
      .groups = "drop"
    )
}
