# =============================================================================
# SECTION 1 — Data loading & cleaning  (unchanged logic, same as before)
# =============================================================================

clean_province <- function(x) {
  x <- gsub("\u00a0", " ", x)
  x <- trimws(x)
  x <- gsub("Bangkok Metropolis", "Bangkok", x, fixed = TRUE)
  x
}

dengue <- read_excel(dengue_path) %>%
  rename_with(tolower) %>%
  mutate(
    province = clean_province(province),
    year     = as.integer(year),
    month    = as.integer(month),
    date     = as.Date(paste(year, sprintf("%02d", month), "01", sep = "-"))
  )

read_indexp_sheet <- function(sheet_num) {
  raw <- read_excel(indexp_path, sheet = sheet_num, col_names = FALSE)
  yr  <- as.integer(raw[[1]][1])
  dat <- raw[-(1:2), ]
  colnames(dat) <- c("row_idx", "province", as.character(1:12))
  dat %>%
    select(-row_idx) %>%
    filter(!is.na(province)) %>%
    pivot_longer(-province, names_to = "month", values_to = "P_index") %>%
    mutate(
      province = clean_province(as.character(province)),
      year     = yr,
      month    = as.integer(month),
      P_index  = as.numeric(P_index)
    )
}

indexp <- bind_rows(lapply(1:10, read_indexp_sheet))

humid <- read_excel(humid_path) %>%
  rename(province = Province_name, month = m, humidity = value) %>%
  mutate(
    province = clean_province(province),
    year     = as.integer(year),
    month    = as.integer(month)
  )

corr_prov <- read_excel(corr_path) %>%
  select(Province, DF_DS, DS_Total, DF_Total) %>%
  rename(province   = Province,
         r_DF_DS    = DF_DS,
         r_DS_total = DS_Total,
         r_DF_total = DF_Total) %>%
  mutate(province = clean_province(province))

master <- dengue %>%
  left_join(indexp,    by = c("province", "year", "month")) %>%
  left_join(humid,     by = c("province", "year", "month")) %>%
  left_join(corr_prov, by = "province")

message("Data loaded. Master: ", nrow(master), " rows.")


