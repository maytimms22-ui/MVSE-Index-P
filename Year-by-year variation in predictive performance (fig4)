compare_provs <- c(high_r[1:3], low_r[1:3])

# Build per-province r labels for strip
r_labels <- corr_prov %>%
  filter(province %in% compare_provs) %>%
  mutate(
    strip_label = paste0(province, "  (r = ", sprintf("%.2f", r_DS_total), ")"),
    perf_group  = if_else(province %in% high_r, "High correlation", "Low correlation")
  ) %>%
  select(province, strip_label, perf_group)

f3_data <- master %>%
  filter(province %in% compare_provs) %>%
  left_join(r_labels, by = "province") %>%
  group_by(province) %>%
  mutate(sf = max(total, na.rm = TRUE) / max(P_index, na.rm = TRUE)) %>%
  ungroup() %>%
  mutate(
    strip_label = factor(strip_label,
                         levels = r_labels$strip_label[match(compare_provs, r_labels$province)]),
    perf_group  = factor(perf_group,
                         levels = c("High correlation", "Low correlation"))
  )

fig3 <- ggplot(f3_data, aes(x = date)) +
