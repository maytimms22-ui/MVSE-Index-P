# =============================================================================
# FIGURE 3 — Province-level Pearson r dot-plot (all 77 provinces)
#            Cleveland dot-plot; performance tiers
# =============================================================================

f6_data <- corr_prov %>%
  mutate(
    tier = case_when(
      r_DS_total >= 0.9  ~ paste0("High (r \u2265 0.90, n = ",
                                  sum(r_DS_total >= 0.9), ")"),
      r_DS_total >= 0.7  ~ paste0("Moderate (0.70\u2013<0.90, n = ",
                                  sum(r_DS_total >= 0.7 & r_DS_total < 0.9), ")"),
      TRUE               ~ paste0("Low (r < 0.70, n = ",
                                  sum(r_DS_total < 0.7), ")")
    )
  ) %>%
  # Fix factor order (compute counts first)
  mutate(
    tier = factor(tier, levels = unique(tier[order(
      c("High","Moderate","Low")[
        match(sub(" \\(.*","",tier), c("High","Moderate","Low"))
      ]
    )]))
  )

# Reorder tier levels cleanly
f6_data <- f6_data %>%
  mutate(tier = factor(
    case_when(
      r_DS_total >= 0.9 ~ "High",
      r_DS_total >= 0.7 ~ "Moderate",
      TRUE              ~ "Low"
    ),
    levels = c("High", "Moderate", "Low")
  ))

fig6 <- ggplot(f6_data,
               aes(x = r_DS_total,
                   y = reorder(province, r_DS_total),
                   colour = tier)) +
  geom_segment(aes(xend = 0.4, yend = province),  # start at 0.4 not 0 (cleaner)
               colour = COL_GRID, linewidth = 0.35) +
  geom_point(size = 1.6) +
  geom_vline(xintercept = 0.50, linetype = "dashed",
             colour = "grey40", linewidth = 0.35) +
  geom_vline(xintercept = 0.70, linetype = "dotted",
             colour = "grey55", linewidth = 0.3) +
  scale_colour_manual(
    name   = "Correlation tier",
    values = c("High" = COL_HIGH, "Moderate" = COL_MOD, "Low" = COL_LOW),
    guide  = guide_legend(override.aes = list(size = 2.5))
  ) +
  scale_x_continuous(
    limits = c(0.35, 1.02),
    breaks = seq(0.4, 1, 0.1),
    expand = c(0, 0)
  ) +
  labs(x = "Spearman r (P-index vs. total dengue cases, pooled 2012\u20132021)",
       y = NULL) +
  theme_pub(base_size = 9, legend_pos = "bottom") +
  theme(
    axis.text.y        = element_text(size = 8.75),
    panel.grid.major.y = element_blank(),
    panel.grid.major.x = element_line(colour = COL_GRID, linewidth = 0.25),
    axis.line.y        = element_blank(),
    axis.ticks.y       = element_blank()
  )

print(fig6)
