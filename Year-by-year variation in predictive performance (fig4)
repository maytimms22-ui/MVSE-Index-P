# =============================================================================
# SECTION 3 — Publication design system
# =============================================================================
# Palette: colourblind-safe, print-friendly
# Primary series:  deep navy   #1B4F72
# Secondary series:#C0392B  (muted red, not neon)
# Accent tiers:    green #1A7A4A | amber #C47F17 | red #922B21
# Neutral base:    white / #F8F9FA / #DEE2E6

COL_CASES  <- "#1B4F72"   # navy  — dengue cases
COL_PINDEX <- "#922B21"   # dark red — P-index
COL_HIGH   <- "#1A7A4A"   # forest green — high performance
COL_MOD    <- "#C47F17"   # amber — moderate
COL_LOW    <- "#922B21"   # dark red — low performance
COL_STRIP  <- "#F0F3F4"   # very light grey strip background
COL_GRID   <- "#DEE2E6"   # subtle grid lines

# Journal figure dimensions (mm → inches at 300 DPI)
# Single column : 86 mm wide  (~3.39 in)
# 1.5 column    : 114 mm wide (~4.49 in)
# Double column : 174 mm wide (~6.85 in)
# Max height    : 230 mm      (~9.06 in)
W_SINGLE <- 3.39
W_1HALF  <- 4.49
W_DOUBLE <- 6.85
H_MAX    <- 9.06

# Save helper — writes TIFF (submission) + PDF (review) at 300 DPI
save_fig <- function(plot, stem, width, height) {
  # TIFF — most journals request TIFF for final submission
  ggsave(paste0(stem, ".tiff"), plot,
         width = width, height = height, units = "in",
         dpi = 300, compression = "lzw", device = "tiff")
  # PDF — vector, useful for revision / review
  ggsave(paste0(stem, ".pdf"), plot,
         width = width, height = height, units = "in",
         device = cairo_pdf)
  message("Saved: ", stem, ".tiff / .pdf")
}

# Publication-grade base theme
# Built on theme_classic() — clean white, no background fill, minimal ink
theme_pub <- function(base_size = 8, legend_pos = "bottom") {
  theme_classic(base_size = base_size, base_family = "sans") +
    theme(
      # Axes
      axis.line         = element_line(colour = "black", linewidth = 0.4),
      axis.ticks        = element_line(colour = "black", linewidth = 0.3),
      axis.ticks.length = unit(2, "pt"),
      axis.text         = element_text(colour = "black", size = base_size - 1),
      axis.title        = element_text(colour = "black", size = base_size,
                                       face = "plain"),
      # Grid — horizontal only, very faint
      panel.grid.major.y = element_line(colour = COL_GRID, linewidth = 0.25),
      panel.grid.major.x = element_blank(),
      panel.grid.minor   = element_blank(),
      # Facet strips — light grey, black text, no bold
      strip.background   = element_rect(fill = COL_STRIP, colour = NA),
      strip.text         = element_text(colour = "black", size = base_size - 1,
                                        face = "plain", margin = margin(2,2,2,2)),
      # Legend
      legend.position    = legend_pos,
      legend.key.size    = unit(8, "pt"),
      legend.text        = element_text(size = base_size - 1),
      legend.title       = element_text(size = base_size - 1, face = "plain"),
      legend.background  = element_blank(),
      legend.key         = element_blank(),
      # Titles — only used for internal drafts; remove for final submission
      plot.title         = element_text(size = base_size, face = "bold",
                                        margin = margin(b = 4)),
      plot.subtitle      = element_text(size = base_size - 1, colour = "grey40",
                                        margin = margin(b = 4)),
      plot.margin        = margin(6, 6, 6, 6)
    )
}


