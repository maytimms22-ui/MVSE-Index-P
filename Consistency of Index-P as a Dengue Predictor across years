# ── 0. Packages ---------------------------------------------------------------
required_pkgs <- c("readxl", "dplyr", "tidyr", "purrr", "sf", "ggplot2",
                   "stringr", "writexl", "scales", "ggtext", "ggspatial",
                   "cowplot", "RColorBrewer")
new_pkgs <- required_pkgs[!required_pkgs %in% installed.packages()[,"Package"]]
if (length(new_pkgs)) install.packages(new_pkgs, dependencies = TRUE)
invisible(lapply(required_pkgs, library, character.only = TRUE))


# ── 1. Helper -----------------------------------------------------------------
clean_name <- function(x) {
  x %>%
    as.character() %>%
    str_replace_all("\u00a0", " ") %>%
    str_squish() %>%
    recode("Bangkok" = "Bangkok Metropolis")
}


# ── 2. Load dengue data -------------------------------------------------------
dengue_raw <- read_excel("dengue_case_2012-2021-all_inclusive.xlsx")
dengue <- dengue_raw %>%
  rename_all(tolower) %>%
  select(province, year, month, total) %>%
  mutate(province = clean_name(province))


# ── 3. Load P-index data ------------------------------------------------------
indexP_file <- read_xlsx("IndexP_monthlydata.xlsx")
indexP_file <- file.choose()
years       <- 2012:2021
sheet_names <- paste0("Sheet", seq_along(years))

read_indexP_sheet <- function(sheet, yr) {
  raw <- read_excel(indexP_file, sheet = sheet, col_names = FALSE, skip = 1)
  raw <- raw[, -1]
  colnames(raw) <- c("province", as.character(1:12))
  raw %>%
    filter(!is.na(province)) %>%
    mutate(year     = yr,
           province = clean_name(as.character(province)))
}

indexP_wide <- map2_dfr(sheet_names, years, read_indexP_sheet)
indexP_long <- indexP_wide %>%
  pivot_longer(cols = as.character(1:12),
               names_to  = "month",
               values_to = "indexP") %>%
  mutate(month  = as.integer(month),
         indexP = as.numeric(indexP))


# ── 4. Merge ------------------------------------------------------------------
combined <- inner_join(dengue, indexP_long,
                       by = c("province", "year", "month")) %>%
  filter(!is.na(indexP), !is.na(total))

cat("Provinces matched:", n_distinct(combined$province), "\n")
cat("Rows in merged:   ", nrow(combined), "\n")


# ── 5. Spearman correlations --------------------------------------------------
cor_results <- combined %>%
  group_by(province, year) %>%
  summarise(
    n_months = n(),
    rho      = if (n_months >= 3)
      cor(indexP, total, method = "spearman", use = "complete.obs")
    else NA_real_,
    p_value  = if (n_months >= 3) {
      tryCatch(
        cor.test(indexP, total, method = "spearman",
                 exact = FALSE)$p.value,
        error = function(e) NA_real_)
    } else NA_real_,
    .groups = "drop"
  ) %>%
  mutate(sig_05 = if_else(!is.na(p_value) & p_value < 0.05, 1L, 0L))


# ── 6. Consistency Score ------------------------------------------------------
consistency <- cor_results %>%
  group_by(province) %>%
  summarise(
    years_tested      = sum(!is.na(rho)),
    years_sig         = sum(sig_05, na.rm = TRUE),
    consistency_score = years_sig,
    mean_rho          = mean(rho, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    tier = case_when(
      consistency_score >= 8 ~ "High (8–10)",
      consistency_score >= 5 ~ "Moderate (5–7)",
      consistency_score >= 1 ~ "Low (1–4)",
      TRUE                   ~ "None (0)"
    ),
    tier = factor(tier, levels = c("High (8–10)", "Moderate (5–7)",
                                   "Low (1–4)", "None (0)"))
  ) %>%
  arrange(desc(consistency_score), desc(mean_rho))

cat("Provinces in consistency table:", nrow(consistency), "\n")


# ── 7. Export -----------------------------------------------------------------
write_xlsx(cor_results, "correlation_by_province_year.xlsx")
write_xlsx(consistency, "consistency_score_by_province.xlsx")

rho_wide <- cor_results %>%
  select(province, year, rho) %>%
  pivot_wider(names_from = year, values_from = rho, names_prefix = "rho_")
write_xlsx(rho_wide, "rho_wide_by_province_year.xlsx")

pval_wide <- cor_results %>%
  select(province, year, p_value) %>%
  pivot_wider(names_from = year, values_from = p_value, names_prefix = "p_")
write_xlsx(pval_wide, "pvalue_wide_by_province_year.xlsx")

cat("✔ Excel outputs saved.\n")


