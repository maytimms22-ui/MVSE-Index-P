# --- 4. LOAD ANNUAL INDEX DATA -----------------------------------------------

read_index_sheet <- function(sheet) {
  raw <- read_excel("IndexP_monthlydata.xlsx", sheet = sheet, col_names = FALSE)
  year_val <- suppressWarnings(as.integer(as.character(raw[[1, 1]])))
  df <- raw[-1, ]
  colnames(df) <- c("row_num","Province", paste0("M", 1:12))
  df %>%
    select(Province, starts_with("M")) %>%
    filter(!is.na(Province), Province != "Province") %>%
    mutate(Province = clean_province(as.character(Province)),
           across(starts_with("M"), as.numeric)) %>%
    rowwise() %>%
    mutate(annual_mean = mean(c_across(starts_with("M")), na.rm = TRUE)) %>%
    ungroup() %>%
    mutate(Year = year_val)
}

index_long <- bind_rows(lapply(excel_sheets("IndexP_monthlydata.xlsx"),
                               read_index_sheet)) %>%
  left_join(region_map, by = "Province")

