# --- 6. KRUSKAL-WALLIS + DUNN POST-HOC --------------------------------------

run_tests <- function(col, label) {
  cat(sprintf("\n\n--- Kruskal-Wallis: %s ---\n", label))
  kw <- kruskal.test(reformulate("Region", col), data = corr_ok)
  print(kw)
  cat(sprintf("\n--- Dunn Post-Hoc (BH): %s ---\n", label))
  dunn <- dunnTest(corr_ok[[col]], corr_ok$Region, method = "bh")
  print(dunn)
  invisible(list(kw=kw, dunn=dunn))
}

cat("\n\n====== STATISTICAL TESTS ======\n")
res_DF_DS  <- run_tests("DF_DS",    "DF vs DS")
res_DS_Tot <- run_tests("DS_Total", "DS vs Total Dengue")
res_DF_Tot <- run_tests("DF_Total", "DF vs Total Dengue")

