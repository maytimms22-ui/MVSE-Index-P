    theme(
      # Axes
      axis.line        = element_line(colour = "black", linewidth = 0.4),
      axis.ticks       = element_line(colour = "black", linewidth = 0.4),
      axis.ticks.length = unit(2.5, "pt"),
      axis.text        = element_text(colour = "black", size = base_size - 1),
      axis.title       = element_text(colour = "black", size = base_size,
                                      face = "plain"),
      panel.border     = element_rect(colour = "black", fill = NA,
                                      linewidth = 0.5),
      panel.background = element_rect(fill = "white"),
      panel.grid.major = element_line(colour = "grey92", linewidth = 0.3),
      panel.grid.minor = element_blank(),
      legend.title     = element_text(size = base_size - 1, face = "bold"),
      legend.text      = element_text(size = base_size - 2),
      legend.key.size  = unit(10, "pt"),
      legend.background = element_rect(fill = "white", colour = NA),
      legend.key       = element_rect(fill = "white", colour = NA),
      strip.background = element_rect(fill = "grey95", colour = "black",
                                      linewidth = 0.4),
      strip.text       = element_text(face = "bold", size = base_size - 1),
      plot.title       = element_blank(),
      plot.subtitle    = element_blank(),
      plot.margin      = margin(4, 6, 4, 6, "pt")
    )
}

# ── FIGURE 1: Three-panel box + jitter (one per correlation type) ─────────
#    Panel A: DF vs DS   B: DS vs Total   C: DF vs Total

make_box_pub <- function(data, y, panel_title) {
  
  # Kruskal-Wallis p annotation
  kw_p    <- kruskal.test(reformulate("Region", y), data = data)$p.value
  p_label <- ifelse(kw_p < 0.001,
                    "italic(P) < 0.001",
                    sprintf("italic(P) == %.3f", kw_p))
  
  ggplot(data, aes(x = Region, y = .data[[y]])) +
    geom_jitter(aes(fill = Region), shape = 21, colour = "white",
                width = 0.16, size = 2.2, alpha = 0.65, stroke = 0.35) +
    geom_boxplot(aes(fill = Region), colour = "black",
                 outlier.shape = NA, alpha = 0.40,
                 width = 0.42, linewidth = 0.45,
                 staplewidth = 0.25) +
    stat_summary(fun = median, geom = "point",
                 shape = 18, size = 4, colour = "black") +
    annotate("text", x = -Inf, y = Inf,
             label = p_label, parse = TRUE,
             hjust = -0.1, vjust = 1.6,
             size = 3.4, colour = "grey25", fontface = "italic") +
    scale_fill_manual(values = region_colours, guide = "none") +
    scale_y_continuous(
      name   = "Spearman r",
      limits = c(0.15, 1.08),
      breaks = seq(0.2, 1.0, by = 0.2),
      labels = number_format(accuracy = 0.1),
      expand = expansion(mult = c(0.02, 0.04))
    ) +
    scale_x_discrete(name = NULL) +
    # Panel title rendered as plot.title (re-enabled for Fig 1 only)
    ggtitle(panel_title) +
    theme_pub(base_size = 12) +
    theme(
      plot.title   = element_text(face = "bold", size = 11,
                                  hjust = 0.5,
                                  margin = margin(b = 4)),
      axis.text.x  = element_text(angle = 30, hjust = 1, vjust = 1,
                                  size = 11),
      axis.title.y = element_text(size = 11),
      plot.margin  = margin(t = 8, r = 10, b = 6, l = 10, unit = "pt")
    )
}

